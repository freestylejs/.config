{
    "name": "@freestylejs/config",
    "version": "1.3.0",
    "description": "Core configurations for freestyle codebase.",
    "files": ["src"],
    "exports": {
        "./biome": "./src/biome/biome-config.json",
        "./tsconfig": "./src/ts/tsconfig.json",
        "./tsconfig-ts7": "./src/ts/tsconfig.ts7.json",
        "./vite": {
            "types": "./src/viteplus/index.d.mts",
            "default": "./src/viteplus/index.mjs"
        }
    },
    "keywords": [
        "config",
        "freestylejs",
        "biome",
        "typescript"
    ],
    "author": "freestyle",
    "license": "MIT",
    "scripts": {
        "lint": "biome lint --write",
        "format": "biome format --write",
        "check": "biome check --write",
        "reporter": "biome check --reporter=summary",
        "publish": "pnpm publish --access public && git push && git push --tags"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/freestylejs/.config"
    },
    "peerDependencies": {
        "@biomejs/biome": ">=2.0.0",
        "typescript": ">=5.0.0"
    }
}
